{
  "name": "wenbu",
  "version": "0.1.4",
  "private": true,
  "description": "Desktop companion for translating and playing local games and manga.",
  "license": "GPL-3.0-only",
  "author": {
    "name": "xianoem",
    "email": "xianoem@users.noreply.github.com"
  },
  "type": "module",
  "main": "./out/main/main.js",
  "imports": {
    "#contract/*": "./src/contract/*.ts",
    "#ui/*": "./src/renderer/ui/*.tsx",
    "#lib/*": "./src/renderer/lib/*.ts"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:native": "node scripts/build-native.mjs",
    "typecheck": "tsc -b",
    "check": "vp check && pnpm typecheck",
    "test": "vp test run",
    "test:python": "uv run --no-project --python 3.11 --with pytest --with numpy==1.26.4 --with opencv-python-headless --with pillow --with fonttools==4.63.0 pytest -q -p no:cacheprovider --basetemp=.pytest-tmp resources/python/wenbu_manga",
    "dist": "electron-vite build && electron-builder --win",
    "prepare": "effect-tsgo patch --typescript",
    "catalog:snapshot": "node scripts/update-model-catalog.ts && vp fmt src/core/llm/modelCatalogSnapshot.json",
    "release": "node scripts/release.ts",
    "python:lock": "uv pip compile resources/python/requirements.in -o resources/python/requirements.txt --python-version 3.11 --python-platform x86_64-pc-windows-msvc --find-links resources/native/win32-x64/wheels --no-header --no-annotate"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@effect/ai-anthropic": "4.0.5",
    "@effect/ai-openai-compat": "4.0.5",
    "@effect/atom-react": "4.0.5",
    "@effect/platform-browser": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/sql-sqlite-node": "4.0.5",
    "@fontsource-variable/geist": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "effect": "4.0.5",
    "electron-updater": "6.8.11",
    "fast-png": "8.0.0",
    "fflate": "0.8.3",
    "node-html-parser": "9.0.4",
    "protobufjs": "8.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@effect/tsgo": "0.56.0",
    "@effect/vitest": "4.0.5",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "packageManager": "pnpm@11.5.2",
  "productName": "Wenbu"
}
